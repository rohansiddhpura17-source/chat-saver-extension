import { useState } from 'react'

export interface Message {
  id: string
  type: 'prompt' | 'response'
  content: string
  timestamp: string
  author: 'User' | 'ChatGPT'
  hasCode: boolean
  codeLanguage?: string
}

export default interface MessageSelectionProps {
  navigateTo: (screen: string, conversation?) => void
  selectedConversation?: any
}

/** Message Selection Interface Screen */
function MessageSelection({ navigateTo, selectedConversation }: MessageSelectionProps) {
  // Mock conversation data - 18 messages
  const [messages, setMessages] = useState<Message[]>(() => [
    {
      id: '1',
      type: 'prompt',
      content: 'Can you explain multi-head self-attention with a PyTorch code implementation and compare it with FlashAttention in a table?',
      timestamp: '10:14 AM',
      author: 'User',
      hasCode: true,
      codeLanguage: 'Python',
    },
    {
      id: '2',
      type: 'response',
      content: 'Multi-head attention projects Queries (Q), Keys (K), and Values (V) into h distinct subspaces, computes scaled dot-product attention in parallel, and concatenates the results: Attention(Q, K, V) = softmax(Q K^T / sqrt(d_k)) * V',
      timestamp: '10:15 AM',
      author: 'ChatGPT',
      hasCode: true,
      codeLanguage: 'Python (PyTorch)',
    },
    {
      id: '3',
      type: 'prompt',
      content: 'What is the memory complexity differences when sequence length grows to 32k tokens?',
      timestamp: '10:19 AM',
      author: 'User',
      hasCode: false,
    },
    {
      id: '4',
      type: 'response',
      content: 'For naive self-attention, the intermediate attention matrix size scales with sequence length N as O(N^2) elements per layer per head. At N = 32,768, a float16 tensor requires 2.14 GB per layer.',
      timestamp: '10:20 AM',
      author: 'ChatGPT',
      hasCode: false,
    },
    {
      id: '5',
      type: 'prompt',
      content: 'Provide the export ready benchmark table and summarize best deployment parameters for NVIDIA H100 SXM5 GPUs.',
      timestamp: '10:23 AM',
      author: 'User',
      hasCode: false,
    },
    {
      id: '6',
      type: 'response',
      content: 'Response 6 content',
      timestamp: '10:25 AM',
      author: 'ChatGPT',
      hasCode: false,
    },
    {
      id: '7',
      type: 'prompt',
      content: 'Prompt 7 content',
      timestamp: '10:28 AM',
      author: 'User',
      hasCode: false,
    },
    {
      id: '8',
      type: 'response',
      content: 'Response 8 content',
      timestamp: '10:30 AM',
      author: 'ChatGPT',
      hasCode: false,
    },
    {
      id: '9',
      type: 'prompt',
      content: 'Prompt 9 content',
      timestamp: '10:33 AM',
      author: 'User',
      hasCode: false,
    },
    {
      id: '10',
      type: 'response',
      content: 'Response 10 content',
      timestamp: '10:35 AM',
      author: 'ChatGPT',
      hasCode: false,
    },
    {
      id: '11',
      type: 'prompt',
      content: 'Prompt 11 content',
      timestamp: '10:38 AM',
      author: 'User',
      hasCode: false,
    },
    {
      id: '12',
      type: 'response',
      content: 'Response 12 content',
      timestamp: '10:40 AM',
      author: 'ChatGPT',
      hasCode: false,
    },
    {
      id: '13',
      type: 'prompt',
      content: 'Prompt 13 content',
      timestamp: '10:43 AM',
      author: 'User',
      hasCode: false,
    },
    {
      id: '14',
      type: 'response',
      content: 'Response 14 content',
      timestamp: '10:45 AM',
      author: 'ChatGPT',
      hasCode: false,
    },
    {
      id: '15',
      type: 'prompt',
      content: 'Prompt 15 content',
      timestamp: '10:48 AM',
      author: 'User',
      hasCode: false,
    },
    {
      id: '16',
      type: 'response',
      content: 'Response 16 content',
      timestamp: '10:50 AM',
      author: 'ChatGPT',
      hasCode: false,
    },
    {
      id: '17',
      type: 'prompt',
      content: 'Prompt 17 content',
      timestamp: '10:53 AM',
      author: 'User',
      hasCode: false,
    },
    {
      id: '18',
      type: 'response',
      content: 'Response 18 content',
      timestamp: '10:55 AM',
      author: 'ChatGPT',
      hasCode: false,
    },
  ])

  const [selectionState, setSelectionState] = useState<{
    selectedCount: number
    promptCount: number
    responseCount: number
    selectedIds: Set<string>
  }>({
    selectedCount: 0,
    promptCount: 0,
    responseCount: 0,
    selectedIds: new Set(),
  })

  const toggleSelectAll = () => {
    const allSelected = selectionState.selectedCount === messages.length
    const newSelection = allSelected ? [] : messages.map(m => m.id)

    setSelectionState(prev => ({
      selectedCount: newSelection.length,
      promptCount: newSelection.filter(id => {
        const msg = messages.find(m => m.id === id)
        return msg?.type === 'prompt'
      }).length,
      responseCount: newSelection.filter(id => {
        const msg = messages.find(m => m.id === id)
        return msg?.type === 'response'
      }).length,
      selectedIds: new Set(newSelection),
    }))
  }

  const toggleMessage = (messageId: string) => {
    setSelectionState(prev => {
      const newSelected = prev.selectedIds.has(messageId)
        ? new Set(prev.selectedIds.delete(messageId))
        : new Set(prev.selectedIds.add(messageId))

      const selectedMessages = [...prev.selectedIds].map(id => messages.find(m => m.id === id)).filter(m => m !== undefined)
      const promptCount = selectedMessages.filter(m => m.type === 'prompt').length
      const responseCount = selectedMessages.filter(m => m.type === 'response').length

      return {
        selectedCount: newSelected.size,
        promptCount,
        responseCount,
        selectedIds: newSelected,
      }
    })
  }

  const exportSelected = () => {
    const count = selectionState.selectedCount
    if (count === 0) {
      alert('Please select at least one message')
      return
    }
    navigateTo('library', {
      title: 'Selected Messages Export',
      platform: 'ChatGPT',
      model: 'ChatGPT 4o',
      metrics: {
        messages: count,
        codeBlocks: count,
        tables: 0,
        recency: 'just now',
      }
    })
  }

  const clearSelection = () => {
    setSelectionState({
      selectedCount: 0,
      promptCount: 0,
      responseCount: 0,
      selectedIds: new Set(),
    })
  }

  return (
    <div className="min-h-screen bg-background text-primary-text">
      <section className="bg-gray-500 py-3 px-4">
        <div className="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 px-6">
          <div className="flex items-center gap-2 min-w-0">
            <a
              className="w-9 h-9 rounded-lg bg-gray-100 hover:bg-gray-200 text-tertiary flex items-center justify-center transition-colors"
              href="#"
              onClick={() => navigateTo('library')}
            >
              <span className="material-symbols-outlined text-[20px]">arrow_back</span>
            </a>
            <div className="flex flex-col">
              <div className="flex items-center gap-2 flex-wrap">
                <span className="px-2 py-0.5 rounded bg-indigo-50 text-indigo-600 font-label-sm text-label-sm uppercase tracking-wide">Source Chat</span>
                <span className="flex items-center gap-1 text-tertiary font-label-sm text-label-sm">
                  <span className="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
                  ChatGPT 4o (Latest)
                </span>
                <span className="text-tertiary font-label-sm text-label-sm">• Captured Today, 10:14 AM</span>
              </div>
              <h1 className="font-headline-md text-headline-md text-on-surface truncate mt-0.5">
                Deep Learning Architecture & Transformer Attention Mechanisms
              </h1>
            </div>
          </div>
          <div className="flex items-center gap-2 md:self-auto shrink-0">
            <div className="hidden xl:flex items-center gap-2 px-2 py-1.5 rounded-lg bg-gray-100 text-tertiary font-label-sm text-label-sm">
              <span className="material-symbols-outlined text-[16px] text-tertiary">lock</span>
              <span>100% In-Memory Parsing</span>
            </div>
            <button
              className="flex items-center gap-2 px-3 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-headline-sm text-headline-sm shadow-sm transition-all"
              id="topExportBtn"
            >
              <span>Export 7 Selected Messages</span>
              <span className="material-symbols-outlined text-[18px]">arrow_forward</span>
            </button>
          </div>
        </div>
      </section>

      <div className="sticky top-16 z-30 w-full bg-gray-50/95 backdrop-blur-md shadow-sm">
        <div className="max-w-7xl mx-auto px-4 py-2 flex flex-wrap items-center justify-between gap-2">
          <div className="flex items-center gap-2 flex-wrap">
            <label className="flex items-center gap-2 cursor-pointer select-none py-1">
              <input
                checked={selectionState.selectedCount > 0}
                class="w-4 h-4 rounded text-indigo-500 focus:ring-indigo-500 accent-indigo-500 cursor-pointer"
                type="checkbox"
                id="masterSelectAll"
                onChange={() => toggleSelectAll()}
              />
              <span className="font-body-sm text-body-sm text-on-surface font-semibold" id="toggleLabel">
                Select All (18)
              </span>
            </label>
            <div className="h-4 w-px bg-gray-100 hidden sm:block"></div>
            <div className="flex items-center gap-2 overflow-x-auto pb-1" id="filterPillGroup">
              <button
                className="filter-chip active flex items-center gap-1 px-2 py-1 rounded-full bg-indigo-500 text-on-indigo font-label-sm text-label-sm font-semibold transition-all"
                onClick={() => toggleSelectAll()}
              >
                <span>All</span>
                <span className="px-1.5 py-0.2 rounded-full bg-indigo text-on-indigo text-[10px]">18</span>
              </button>
              <button
                className="filter-chip flex items-center gap-1 px-2 py-1 rounded-full bg-gray-50 hover:bg-gray-100 text-tertiary font-label-sm text-label-sm transition-all"
                onClick={() => setSelectionState(prev => ({...prev, selectedCount: 0}))}
              >
                <span>Prompts</span>
                <span className="px-1.5 py-0.2 rounded-full bg-gray-100 text-tertiary text-[10px]">9</span>
              </button>
              <button
                className="filter-chip flex items-center gap-1 px-2 py-1 rounded-full bg-gray-50 hover:bg-gray-100 text-tertiary font-label-sm text-label-sm transition-all"
                onClick={() => setSelectionState(prev => ({...prev, selectedCount: 0}))}
              >
                <span>AI Responses</span>
                <span className="px-1.5 py-0.2 rounded-full bg-gray-100 text-tertiary text-[10px]">9</span>
              </button>
              <button
                className="filter-chip flex items-center gap-1 px-2 py-1 rounded-full bg-gray-50 hover:bg-gray-100 text-tertiary font-label-sm text-label-sm transition-all"
                onClick={() => setSelectionState(prev => ({...prev, selectedCount: 0}))}
              >
                <span className="material-symbols-outlined text-[13px]">code</span>
                <span>Contains Code</span>
                <span className="px-1.5 py-0.2 rounded-full bg-gray-100 text-tertiary text-[10px]">6</span>
              </button>
            </div>
          </div>

          <div className="flex items-center gap-2">
            <div className="flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500 text-on-indigo-500 font-label-sm text-label-sm font-shadow-sm">
              <span className="material-symbols-outlined text-[16px]">check_circle</span>
              <span id="selectedCountPill">
                {selectionState.selectedCount} messages selected ({selectionState.promptCount} Prompts, {selectionState.responseCount} Responses)
              </span>
            </div>
          </div>
        </div>
      </div>

      <div className="px-4 pb-32 flex flex-col gap-3">
        <div className="space-y-2">
          {messages.map((msg, msgIndex) => (
            <article
              key={msg.id}
              className="message-card group bg-gray-50 rounded-xl p-4 shadow-sm transition-all hover:shadow-md"
              style={{
                backgroundColor: selectionState.selectedIds.has(msg.id) ? '#f3f4f6' : '#f9fafb',
              }}
              data-has-code={msg.hasCode.toString()}
              data-type={msg.type}
            >
              <div className="flex items-start gap-3">
                <div className="pt-1 shrink-0">
                  <input
                    checked={selectionState.selectedIds.has(msg.id)}
                    class="w-4 h-4 rounded text-indigo-500 focus:ring-indigo-500 accent-indigo-500 cursor-pointer"
                    type="checkbox"
                    onChange={() => toggleMessage(msg.id)}
                  />
                </div>
                <div className="flex-1 min-w-0">
                  <div className="flex items-center justify-between gap-2 mb-1">
                    <div className="flex items-center gap-2">
                      <div className="w-6 h-6 rounded-full bg-gray-100 text-gray-900 flex items-center justify-center font-sm font-bold">
                        {msg.author === 'User' ? 'U' : 'A'}
                      </div>
                      <span className="font-headline-sm font-headline-sm text-on-surface">{msg.author}</span>
                      <span className="font-code-inline text-code-inline text-tertiary">• {msg.timestamp}</span>
                      <span className="px-2 py-0.5 rounded bg-gray-100 text-tertiary font-label-sm text-[10px] uppercase tracking-wide">Prompt #{msgIndex + 1}</span>
                    </div>
                    <div className="flex items-center gap-2 opacity-70 group-hover:opacity-100 transition-opacity">
                      <button className="p-1 rounded hover:bg-gray-100 text-tertiary" title="Copy Message Text">
                        <span className="material-symbols-outlined text-[16px]">content_copy</span>
                      </button>
                    </div>
                  </div>
                  <div className="font-body-md text-body-md text-on-surface">
                    {msg.content}
                  </div>
                </div>
              </div>
            </article>
            ))}
            {messages.length > 5 && (
              <div key="divider" className="flex items-center gap-3 py-2 opacity-60">
                <div className="h-px bg-gray-100 flex-1"></div>
                <span className="font-label-sm text-label-sm text-tertiary uppercase tracking-wider">
                  Remaining {messages.length - 5} Messages in Thread
                </span>
                <div className="h-px bg-gray-100 flex-1"></div>
              </div>
            )}
          </div>
          <aside className="fixed bottom-4 left-64 right-0 px-4 z-40 pointer-events-none">
            <div className="max-w-4xl mx-auto w-full pointer-events-auto">
              <div className="bg-gray-900 text-gray-100 rounded-xl shadow-xl px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
                <div className="flex items-center gap-2 min-w-0">
                  <div className="w-8 h-8 rounded-lg bg-gray-500/15 flex items-center justify-center shrink-0">
                    <span className="material-symbols-outlined text-[24px] text-indigo-400">bookmark_check</span>
                  </div>
                  <div className="flex flex-col min-w-0">
                    <div className="flex items-center gap-2">
                      <span className="font-headline-sm font-headline-sm text-indigo-100 font-semibold" id="bottomSelectedTitle">
                        {selectionState.selectedCount} of {messages.length} messages selected
                      </span>
                      <span className="w-1.5 h-1.5 rounded-full bg-indigo-500"></span>
                      <span className="font-code-inline text-code-inline text-indigo-100">~1,420 words</span>
                    </div>
                    <span className="font-body-sm text-body-sm text-tertiary truncate">
                      Includes code snippets and benchmark tables
                    </span>
                  </div>
                </div>
                <div className="flex items-center gap-2 shrink-0 w-full sm:w-auto justify-end">
                  <button
                    className="px-3 py-2 rounded-lg bg-gray-500/10 hover:bg-gray-500/20 text-tertiary font-headline-sm text-body-md transition-colors"
                    id="clearSelectionBtn"
                    onClick={clearSelection}
                  >
                    Clear selection
                  </button>
                  <button
                    className="flex items-center gap-2 px-4 py-2.5 rounded-lg bg-indigo-500 hover:bg-indigo-400 text-white font-headline-sm text-headline-sm shadow-md transition-all"
                  >
                    <span className="material-symbols-outlined text-[18px]">file_download</span>
                    <span>Export Selected</span>
                    <span className="px-1.5 py-0.5 rounded bg-indigo-50/30 font-code-inline text-[11px] text-on-indigo">PDF/MD</span>
                  </button>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  )
}

